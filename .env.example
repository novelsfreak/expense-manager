# MongoDB Connection String
# For local development, use: mongodb://localhost:27017/expense-manager
# For MongoDB Atlas (cloud), use: mongodb+srv://username:password@cluster.mongodb.net/expense-manager
MONGODB_URI=mongodb://localhost:27017/expense-manager

# Server Port (optional, defaults to 3001)
PORT=3001

# JWT Secret Key (change this to a random string in production)
JWT_SECRET=your-secret-key-change-this-in-production
